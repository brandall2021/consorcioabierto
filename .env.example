# ConsorcioAbierto — variables de entorno (sin credenciales reales)
# Copiar a .env y completar según docs/environments.md

# App
APP_ENV=local
APP_BASE_URL=http://localhost:8080
APP_HTTP_ADDR=:8080
APP_REQUEST_TIMEOUT=30s

# Compose (deploy/compose.yaml) — puertos host
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Base de datos (pgx)
DATABASE_URL=postgres://consorcio:consorcio@localhost:5432/consorcioabierto?sslmode=disable

# Identidad / sesión
JWT_PRIVATE_KEY=
REFRESH_TOKEN_TTL=720h
ACCESS_TOKEN_TTL=10m
LOGIN_MAX_ATTEMPTS=5
MFA_REQUIRED_ROLES=tenant_admin,consorcio_admin,tesorero

# Storage (S3-compatible)
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=consorcio-docs
S3_ACCESS_KEY=consorcio
S3_SECRET_KEY=consorcio-secret
S3_REGION=us-east-1
S3_SIGNED_URL_TTL=5m
MAX_UPLOAD_BYTES=15728640

# Correo
MAIL_DRIVER=mailpit
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-responder@consorcioabierto.local

# PSP (mock hasta decisión del owner)
PSP_DRIVER=mock

# Observabilidad
OTEL_EXPORTER=console
OTEL_METRICS_PORT=9090
LOG_FORMAT=json
