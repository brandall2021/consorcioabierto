# ConsorcioAbierto — Backend Go
# Build multi-stage. Compila el binario del API y lo ejecuta como imagen final.
# El API escucha en APP_HTTP_ADDR (default :8080). Las migraciones corren con:
#   docker run --rm IMG migrate up   (usa DATABASE_URL_ADMIN)
FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/api ./apps/api

FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata

COPY --from=build /out/api /usr/local/bin/api
COPY db/migrations /app/db/migrations

WORKDIR /app
ENV APP_HTTP_ADDR=:8080

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/api"]
CMD []
